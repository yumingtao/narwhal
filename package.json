{
  "name": "narwhal",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "dshRuntime": "npm@0.1.1-rc.2",
  "author": "yumingtao <10069214+yumingtao@users.noreply.github.com>",
  "description": "A local-first, privacy-first AI agent. Your conversations, projects, and work context stay on your machine.",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run build && electron .",
    "dev:web": "vite --config vite.config.ts --host",
    "start": "electron .",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "package:mac": "pnpm run build && pnpm run stage:runtime && electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "build": {
    "appId": "com.narwhal.app",
    "productName": "Narwhal",
    "icon": "build/icon.icns",
    "asar": true,
    "disableDefaultIgnoredFiles": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**",
      "dist/preload/**",
      "dist/recovery/**",
      "dist/renderer/**",
      "dist/shared/**",
      "runtime/manifest.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/dsh/node_modules",
        "to": "runtime/dsh/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/dsh/package.json",
        "to": "runtime/dsh/package.json"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "asarUnpack": [
        "**/*.node"
      ],
      "identity": "-"
    },
    "afterSign": "scripts/notarize.cjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
